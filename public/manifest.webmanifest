{
  "name": "WingTips",
  "short_name": "WingTips",
  "description": "The layover guide written by KLM crew, for KLM crew.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#003082",
  "theme_color": "#003082",
  "share_target": {
    "action": "/share-gpx",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "gpx", "accept": [".gpx", "application/gpx+xml", "application/xml", "text/xml", "application/octet-stream"] }]
    }
  },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
